# Choose ollama for local application preparation, or openai for the paid API.
# An explicit prepare/doctor --provider flag overrides this setting.
APPLICATION_PROVIDER=ollama

# Central matching is the recommended default for Ishwar's workflow: local NLI evidence plus a local Ollama selector for 2-4 central technical requirements. Set classifier to retain the legacy no-generative matching path; llm restores the older full-LLM matcher.
APPLICATION_MATCHER=central
# Pretrained NLI baseline, loaded only from cached files; no automatic downloads.
REQUIREMENT_NLI_MODEL=cross-encoder/nli-deberta-v3-small
REQUIREMENT_NLI_REVISION=
REQUIREMENT_NLI_DEVICE=cpu

# Existing local Ollama installation. The application accepts loopback hosts only.
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=4096
OLLAMA_TIMEOUT_SECONDS=600

# Optional independent LOCAL CV critic; blank keeps the writer's self-audit.
# Install separately: ollama pull ministral-3:8b
# Set CV_CRITIC_MODEL=ministral-3:8b only after reviewing local test results.
CV_CRITIC_MODEL=
CV_CRITIC_NUM_CTX=12288
CV_CRITIC_NUM_PREDICT=4096
CV_CRITIC_TIMEOUT_SECONDS=900
# With critic enabled, use OLLAMA_NUM_CTX=12288 and OLLAMA_TIMEOUT_SECONDS=900
# as a starting point for an 8 GB GPU. Models unload between sequential calls.

# Optional: only needed when selecting --provider openai.
OPENAI_API_KEY=
# Set a model available to your OpenAI API project that supports Structured Outputs.
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=6000

ADZUNA_APP_ID=
ADZUNA_APP_KEY=

GREENHOUSE_BOARD_TOKEN=
GREENHOUSE_COMPANY=

LEVER_COMPANY_SLUG=
LEVER_COMPANY=

THE_MUSE_API_KEY=
